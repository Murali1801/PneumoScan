{
  "raw_dir": "/content/project/data/raw",
  "processed_dir": "/content/project/data/processed",
  "splits_csv": "/content/project/data/splits.csv",
  "out_dir": "/content/project/reports",
  "ckpt_dir": "/content/project/checkpoints",
  "img_size": 224,
  "clahe_clip": 2.0,

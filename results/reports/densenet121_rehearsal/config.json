  "finetune_epochs": 2,
  "finetune_lr": 0.0001,
  "unfreeze_from": 0.5,
  "patience": 4,
  "use_class_weights": true,
  "aug_rotation": 0.03,
  "aug_translation": 0.06,
  "aug_zoom": 0.1,
  "aug_contrast": 0.1,
  "iou_threshold": 0.5,
  "tag": "rehearsal"
